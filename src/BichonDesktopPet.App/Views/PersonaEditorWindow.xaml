<Window x:Class="BichonDesktopPet.App.Views.PersonaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宠物个性设置"
        Width="560"
        Height="760"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#FFF8F5F1">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="宠物身份与个性"
                 FontSize="23"
                 FontWeight="Bold"
                 Foreground="#FF49352F" />
      <TextBlock Text="为每只宠物单独设置名字、称呼和表达方式。这些资料保存在本机，当前版本使用规则文案，不调用 AI。"
                 Margin="0,6,0,0"
                 FontSize="12"
                 Foreground="#FF8B7770"
                 TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="基础身份"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#FF604840"
                   Margin="0,0,0,8" />
        <TextBlock Text="宠物名字（1–40 个字符）" FontSize="11" Foreground="#FF8B7770" Margin="0,0,0,4" />
        <TextBox x:Name="NameTextBox" Height="32" Padding="8,5" FontSize="12" />

        <TextBlock Text="物种类型" FontSize="11" Foreground="#FF8B7770" Margin="0,10,0,4" />
        <ComboBox x:Name="SpeciesComboBox" Height="32" SelectedValuePath="Tag">
          <ComboBoxItem Content="狗狗" Tag="dog" />
          <ComboBoxItem Content="猫咪" Tag="cat" />
          <ComboBoxItem Content="兔子" Tag="rabbit" />
          <ComboBoxItem Content="爬行动物" Tag="reptile" />
          <ComboBoxItem Content="人形角色" Tag="humanoid" />
          <ComboBoxItem Content="自定义" Tag="custom" />
        </ComboBox>

        <TextBlock Text="品种 / 子类型（可选）" FontSize="11" Foreground="#FF8B7770" Margin="0,10,0,4" />
        <TextBox x:Name="BreedTextBox" Height="32" Padding="8,5" FontSize="12" />

        <TextBlock Text="宠物昵称（最多 5 个，用逗号分隔）" FontSize="11" Foreground="#FF8B7770" Margin="0,10,0,4" />
        <TextBox x:Name="NicknamesTextBox" Height="32" Padding="8,5" FontSize="12" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="宠物自称" FontSize="11" Foreground="#FF8B7770" Margin="0,0,0,4" />
            <TextBox x:Name="SelfReferenceTextBox" Height="32" Padding="8,5" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="对用户的称呼" FontSize="11" Foreground="#FF8B7770" Margin="0,0,0,4" />
            <TextBox x:Name="UserAddressTextBox" Height="32" Padding="8,5" FontSize="12" />
          </StackPanel>
        </Grid>

        <Separator Margin="0,18,0,14" Background="#FFE9DDD5" />
        <TextBlock Text="性格与表达"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#FF604840"
                   Margin="0,0,0,8" />
        <TextBlock Text="主要性格（最多 3 项，例如：活泼、黏人、好奇）"
                   FontSize="11" Foreground="#FF8B7770" Margin="0,0,0,4" />
        <TextBox x:Name="TraitsTextBox" Height="32" Padding="8,5" FontSize="12" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="语言风格" FontSize="11" Foreground="#FF8B7770" Margin="0,0,0,4" />
            <ComboBox x:Name="SpeechStyleComboBox" Height="32" SelectedValuePath="Tag" SelectedValue="cute">
              <ComboBoxItem Content="可爱" Tag="cute" />
              <ComboBoxItem Content="温柔" Tag="gentle" />
              <ComboBoxItem Content="高冷" Tag="cool" />
              <ComboBoxItem Content="傲娇" Tag="tsundere" />
              <ComboBoxItem Content="活泼" Tag="playful" />
              <ComboBoxItem Content="自然" Tag="natural" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="回应长度" FontSize="11" Foreground="#FF8B7770" Margin="0,0,0,4" />
            <ComboBox x:Name="ResponseLengthComboBox" Height="32" SelectedValuePath="Tag" SelectedValue="short">
              <ComboBoxItem Content="简短" Tag="short" />
              <ComboBoxItem Content="适中" Tag="medium" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <TextBlock Text="表情符号频率" FontSize="11" Foreground="#FF8B7770" Margin="0,10,0,4" />
        <ComboBox x:Name="EmojiLevelComboBox" Height="32" SelectedValuePath="Tag" SelectedValue="medium">
          <ComboBoxItem Content="少量" Tag="low" />
          <ComboBoxItem Content="适中" Tag="medium" />
          <ComboBoxItem Content="丰富" Tag="high" />
        </ComboBox>

        <TextBlock Text="口头禅（最多 5 条，每行一条）" FontSize="11" Foreground="#FF8B7770" Margin="0,10,0,4" />
        <TextBox x:Name="CatchphrasesTextBox"
                 Height="76"
                 Padding="8,6"
                 FontSize="12"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText"
                 Grid.Column="0"
                 VerticalAlignment="Center"
                 FontSize="11"
                 Foreground="#FFB95F58"
                 TextWrapping="Wrap"
                 Margin="0,0,12,0" />
      <Button Grid.Column="1"
              Content="取消"
              Width="82"
              Height="36"
              Margin="0,0,8,0"
              Background="#FFFFF1E8"
              BorderBrush="#FFE8CFC1"
              Foreground="#FF805C4F"
              Click="Cancel_Click" />
      <Button Grid.Column="2"
              Content="保存资料"
              Width="96"
              Height="36"
              Background="#FFB95F58"
              BorderBrush="#FFB95F58"
              Foreground="White"
              FontWeight="SemiBold"
              Click="Save_Click" />
    </Grid>
  </Grid>
</Window>
