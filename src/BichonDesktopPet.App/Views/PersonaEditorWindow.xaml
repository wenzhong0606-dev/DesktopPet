<Window x:Class="BichonDesktopPet.App.Views.PersonaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宠物个性设置" Width="560" Height="760" MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#FFF7F6F2" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="#FFFBFAF7" /><Setter Property="BorderBrush" Value="#FFE0DED6" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#FF303630" />
      <Setter Property="Padding" Value="9,6" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="#FFFBFAF7" /><Setter Property="BorderBrush" Value="#FFE0DED6" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#FF303630" />
      <Setter Property="Padding" Value="8,5" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="EditorButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="13,8" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#FFE0DED6" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF596158" /><Setter Property="FontSize" Value="11.5" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFECEDE7" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EditorPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource EditorButtonStyle}">
      <Setter Property="Background" Value="#FF526458" /><Setter Property="BorderBrush" Value="#FF526458" />
      <Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="宠物身份与个性" FontSize="23" FontWeight="SemiBold" Foreground="#FF303630" />
      <TextBlock Text="管理标签只用于区分角色；聊天中使用宠物昵称，并遵循这里设置的表达风格。"
                 Margin="0,5,0,0" FontSize="11.5" Foreground="#FF858A82" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="基础身份" FontSize="13" FontWeight="SemiBold" Foreground="#FF424940" Margin="0,0,0,8" />
        <TextBlock Text="管理名称（仅用于角色列表区分）" FontSize="10.5" Foreground="#FF858A82" Margin="0,0,0,4" />
        <TextBox x:Name="NameTextBox" Height="32" Padding="9,5" FontSize="12" />
        <TextBlock Text="物种类型" FontSize="10.5" Foreground="#FF858A82" Margin="0,10,0,4" />
        <ComboBox x:Name="SpeciesComboBox" Height="32" SelectedValuePath="Tag">
          <ComboBoxItem Content="狗狗" Tag="dog" /><ComboBoxItem Content="猫咪" Tag="cat" />
          <ComboBoxItem Content="兔子" Tag="rabbit" /><ComboBoxItem Content="爬行动物" Tag="reptile" />
          <ComboBoxItem Content="人形角色" Tag="humanoid" /><ComboBoxItem Content="自定义" Tag="custom" />
        </ComboBox>
        <TextBlock Text="品种 / 子类型（可选）" FontSize="10.5" Foreground="#FF858A82" Margin="0,10,0,4" />
        <TextBox x:Name="BreedTextBox" Height="32" Padding="9,5" FontSize="12" />
        <TextBlock Text="宠物昵称（第一项为常用名字，其余为别名；最多 5 个）" FontSize="10.5" Foreground="#FF858A82" Margin="0,10,0,4" />
        <TextBox x:Name="NicknamesTextBox" Height="32" Padding="9,5" FontSize="12" />
        <TextBlock Text="用逗号分隔。第一个昵称用于聊天称呼与角色身份，其余昵称只作为别名。"
                   FontSize="10" Foreground="#FF92978F" Margin="0,4,0,0" TextWrapping="Wrap" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="宠物自称" FontSize="10.5" Foreground="#FF858A82" Margin="0,0,0,4" />
            <TextBox x:Name="SelfReferenceTextBox" Height="32" Padding="9,5" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="对用户的称呼" FontSize="10.5" Foreground="#FF858A82" Margin="0,0,0,4" />
            <TextBox x:Name="UserAddressTextBox" Height="32" Padding="9,5" FontSize="12" />
          </StackPanel>
        </Grid>
        <Separator Margin="0,18,0,14" Background="#FFE1DFD7" />
        <TextBlock Text="性格与表达" FontSize="13" FontWeight="SemiBold" Foreground="#FF424940" Margin="0,0,0,8" />
        <TextBlock Text="主要性格（最多 3 项，例如：活泼、黏人、好奇）" FontSize="10.5" Foreground="#FF858A82" Margin="0,0,0,4" />
        <TextBox x:Name="TraitsTextBox" Height="32" Padding="9,5" FontSize="12" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="语言风格" FontSize="10.5" Foreground="#FF858A82" Margin="0,0,0,4" />
            <ComboBox x:Name="SpeechStyleComboBox" Height="32" SelectedValuePath="Tag" SelectedValue="cute">
              <ComboBoxItem Content="可爱" Tag="cute" /><ComboBoxItem Content="温柔" Tag="gentle" />
              <ComboBoxItem Content="高冷" Tag="cool" /><ComboBoxItem Content="傲娇" Tag="tsundere" />
              <ComboBoxItem Content="活泼" Tag="playful" /><ComboBoxItem Content="自然" Tag="natural" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="回应长度" FontSize="10.5" Foreground="#FF858A82" Margin="0,0,0,4" />
            <ComboBox x:Name="ResponseLengthComboBox" Height="32" SelectedValuePath="Tag" SelectedValue="short">
              <ComboBoxItem Content="简短" Tag="short" /><ComboBoxItem Content="适中" Tag="medium" />
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBlock Text="表情符号频率" FontSize="10.5" Foreground="#FF858A82" Margin="0,10,0,4" />
        <ComboBox x:Name="EmojiLevelComboBox" Height="32" SelectedValuePath="Tag" SelectedValue="medium">
          <ComboBoxItem Content="少量" Tag="low" /><ComboBoxItem Content="适中" Tag="medium" /><ComboBoxItem Content="丰富" Tag="high" />
        </ComboBox>
        <TextBlock Text="口头禅（最多 5 条，每行一条）" FontSize="10.5" Foreground="#FF858A82" Margin="0,10,0,4" />
        <TextBox x:Name="CatchphrasesTextBox" Height="76" Padding="9,6" FontSize="12" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontSize="10.5"
                 Foreground="#FF8B665B" TextWrapping="Wrap" Margin="0,0,12,0" />
      <Button Grid.Column="1" Content="取消" Width="82" Height="36" Margin="0,0,8,0"
              Style="{StaticResource EditorButtonStyle}" Click="Cancel_Click" />
      <Button Grid.Column="2" Content="保存资料" Width="96" Height="36"
              Style="{StaticResource EditorPrimaryButtonStyle}" Click="Save_Click" />
    </Grid>
  </Grid>
</Window>