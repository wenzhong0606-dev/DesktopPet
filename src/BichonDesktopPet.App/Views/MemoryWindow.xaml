<Window x:Class="BichonDesktopPet.App.Views.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="伙伴记忆" Width="590" Height="840" MinWidth="490" MinHeight="730"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FFF7F6F2" FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="伙伴记忆" FontSize="23" FontWeight="SemiBold" Foreground="#FF303630"/>
      <TextBlock Text="每个伙伴独立保存。开启自动记忆后，日常对话中明确表达的普通偏好可自动记录，无需手动保存。"
                 TextWrapping="Wrap" Margin="0,6,0,12" Foreground="#FF626A61"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <CheckBox x:Name="AutomaticCheckBox" Content="允许从新对话自动形成记忆（本机处理）"
                Checked="AutomaticChanged" Unchecked="AutomaticChanged"/>
      <TextBlock Text="默认关闭；识别明确的饮食、音乐、兴趣、色彩偏好及部分偏好变化。不回扫旧对话，不覆盖手动确认。"
                 TextWrapping="Wrap" Foreground="#FF626A61" Margin="0,5,0,10"/>
      <CheckBox x:Name="RetrievalCheckBox" Content="允许聊天使用相关记忆（会发送给 Qwen）"
                Checked="RetrievalChanged" Unchecked="RetrievalChanged"/>
      <TextBlock Text="默认关闭；仅发送相关且未过期、未归档的记忆，条数随上下文预算变化。关闭不撤回已发送内容。"
                 TextWrapping="Wrap" Foreground="#FF626A61" Margin="0,5,0,0"/>
    </StackPanel>
    <ListBox x:Name="MemoryList" Grid.Row="2" Background="#FFFBFAF7" BorderBrush="#FFE4E2DA"
             SelectionChanged="MemoryList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Margin="8,7">
          <TextBlock Text="{Binding Topic}" FontWeight="SemiBold" Foreground="#FF303630"/>
          <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#FF626A61" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap" FontSize="11" Foreground="#FF727A71" Margin="0,4,0,0"/>
        </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <WrapPanel Margin="0,0,0,10">
        <Button x:Name="PreviousPageButton" Content="上一页" Click="PreviousPage_Click" Padding="12,5" Margin="0,0,8,0"/>
        <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="NextPageButton" Content="下一页" Click="NextPage_Click" Padding="12,5"/>
      </WrapPanel>
      <TextBlock Text="主题（1–40 字符；同主题保存会更新已有记忆）" Foreground="#FF626A61"/>
      <TextBox x:Name="TopicInput" MaxLength="40" Padding="8" Margin="0,5,0,10"/>
      <TextBlock Text="记忆内容（最多 200 字符）" Foreground="#FF626A61"/>
      <TextBox x:Name="ContentInput" MaxLength="200" Height="70" Padding="8" Margin="0,5,0,10"
               TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
      <WrapPanel>
        <Button Content="保存记忆" Click="Save_Click" Padding="14,7" Margin="0,0,8,5"/>
        <Button Content="新建" Click="New_Click" Padding="14,7" Margin="0,0,8,5"/>
        <Button Content="删除所选" Click="Delete_Click" Padding="14,7" Margin="0,0,8,5"/>
        <Button Content="清空记忆" Click="Clear_Click" Padding="14,7" Margin="0,0,8,5"/>
      </WrapPanel>
      <WrapPanel Margin="0,4,0,0">
        <Button Content="切换重要" Click="Important_Click" Padding="10,5" Margin="0,0,6,5"/>
        <Button Content="归档 / 恢复" Click="Archive_Click" Padding="10,5" Margin="0,0,6,5"/>
        <Button Content="有效30天" Click="Expiry_Click" Padding="10,5" Margin="0,0,6,5"/>
        <Button Content="永久有效" Click="Permanent_Click" Padding="10,5" Margin="0,0,6,5"/>
      </WrapPanel>
      <TextBlock Text="新自动偏好默认有效180天，再次明确陈述可续期；归档或过期后不再引用，但仍可查看。聊天历史独立保存。"
                 TextWrapping="Wrap" Foreground="#FF626A61" Margin="0,5,0,0"/>
    </StackPanel>
    <Grid Grid.Row="4" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FF626A61"/>
      <Button Grid.Column="1" Content="完成" IsCancel="True" Padding="16,8" Margin="8,0,0,0"/>
    </Grid>
  </Grid>
</Window>
