<Window x:Class="BichonDesktopPet.App.Views.AvatarManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色管理" Width="540" Height="700" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#FFF7F6F2" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="ManagerButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="0,0,7,7" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#FFE0DED6" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#FF596158" />
      <Setter Property="FontSize" Value="11.5" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFECEDE7" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ManagerPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ManagerButtonStyle}">
      <Setter Property="Background" Value="#FF526458" /><Setter Property="BorderBrush" Value="#FF526458" /><Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="#FFFBFAF7" /><Setter Property="BorderBrush" Value="#FFE0DED6" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#FF303630" />
      <Setter Property="Padding" Value="9,6" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="#FFFBFAF7" /><Setter Property="BorderBrush" Value="#FFE0DED6" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="#FF303630" />
      <Setter Property="Padding" Value="8,5" /><Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="角色管理" FontSize="23" FontWeight="SemiBold" Foreground="#FF303630" />
      <TextBlock Text="在这里管理图片角色。管理名称只用于区分宠物，聊天时使用宠物昵称。"
                 Margin="0,5,0,0" FontSize="11.5" Foreground="#FF858A82" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox x:Name="AvatarListBox" Grid.Row="1" BorderThickness="0" Background="Transparent"
             SelectionMode="Single" SelectionChanged="AvatarListBox_SelectionChanged"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}">
          <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Focusable" Value="True" /><Setter Property="IsTabStop" Value="True" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border x:Name="RowSurface" Padding="12,11" Margin="0,0,0,1" Background="Transparent"
                  BorderBrush="#FFE5E2DA" BorderThickness="0,0,0,1" CornerRadius="0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FF343A34" />
                <TextBlock Text="{Binding PrimaryNicknameDisplay}" FontSize="10.5" Foreground="#FF59665B" Margin="0,3,0,0" />
                <TextBlock Text="{Binding SpeciesDisplayName}" FontSize="10.5" Foreground="#FF858A82" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Breed}" FontSize="10" Foreground="#FF9A9E96" Margin="0,2,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" Foreground="#FF858A82">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="本地" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Text" Value="内置" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
              <Setter TargetName="RowSurface" Property="Background" Value="#FFECEDE7" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <Separator Background="#FFE1DFD7" />
      <TextBlock Text="导入新角色" Margin="0,12,0,8" FontSize="13" FontWeight="SemiBold" Foreground="#FF424940" />
      <TextBlock Text="管理名称（仅用于区分，不是宠物在聊天中使用的名字）" FontSize="10.5" Foreground="#FF858A82" Margin="0,0,0,4" />
      <TextBox x:Name="AvatarNameTextBox" Height="34" ToolTip="仅用于角色管理列表中区分不同宠物" />
      <TextBlock Text="角色类型" FontSize="10.5" Foreground="#FF858A82" Margin="0,9,0,4" />
      <ComboBox x:Name="SpeciesComboBox" Height="34" SelectedIndex="5">
        <ComboBoxItem Content="狗狗" Tag="dog" /><ComboBoxItem Content="猫咪" Tag="cat" />
        <ComboBoxItem Content="兔子" Tag="rabbit" /><ComboBoxItem Content="爬行动物" Tag="reptile" />
        <ComboBoxItem Content="人形角色" Tag="humanoid" /><ComboBoxItem Content="自定义" Tag="custom" />
      </ComboBox>
    </StackPanel>
    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
      <Button Content="导入图片..." Style="{StaticResource ManagerButtonStyle}" Click="Import_Click" />
      <Button x:Name="EditPersonaButton" Content="编辑昵称与个性" Style="{StaticResource ManagerButtonStyle}" Click="EditPersona_Click" />
      <Button x:Name="SetActiveButton" Content="设为当前角色" Style="{StaticResource ManagerPrimaryButtonStyle}" Click="SetActive_Click" />
      <Button x:Name="DeleteButton" Content="删除所选角色" Style="{StaticResource ManagerButtonStyle}" Click="Delete_Click" />
      <Button Content="恢复比熊默认" Style="{StaticResource ManagerButtonStyle}" Click="RestoreDefault_Click" />
    </WrapPanel>
    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="CurrentAvatarText" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF50584F" />
        <TextBlock x:Name="StatusText" FontSize="10" Foreground="#FF858A82" Margin="0,4,12,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="完成" Width="82" Height="34"
              Style="{StaticResource ManagerPrimaryButtonStyle}" VerticalAlignment="Center" Click="Close_Click" />
    </Grid>
  </Grid>
</Window>