<Window x:Class="BichonDesktopPet.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="比熊桌宠设置"
        Width="420"
        Height="520"
        MinWidth="420"
        MinHeight="520"
        MaxWidth="420"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF8F5F1"
        Loaded="Window_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="桌宠设置"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="#FF49352F" />
      <TextBlock Text="调整比熊在桌面上的显示与陪伴效果"
                 Margin="0,6,0,0"
                 FontSize="12"
                 Foreground="#FF8B7770" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="White"
            BorderBrush="#FFE9DDD5"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18">
      <StackPanel>
        <TextBlock Text="桌面行为"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#FF604840"
                   Margin="0,0,0,14" />

        <CheckBox x:Name="AlwaysOnTopCheckBox"
                  Content="窗口始终置顶"
                  FontSize="13"
                  Foreground="#FF49352F"
                  Margin="0,0,0,16"
                  Checked="SettingChanged"
                  Unchecked="SettingChanged" />

        <CheckBox x:Name="SnowCheckBox"
                  Content="显示飘落的雪花"
                  FontSize="13"
                  Foreground="#FF49352F"
                  Margin="0,0,0,16"
                  Checked="SettingChanged"
                  Unchecked="SettingChanged" />

        <CheckBox x:Name="LightsCheckBox"
                  Content="开启装饰灯效果"
                  FontSize="13"
                  Foreground="#FF49352F"
                  Margin="0,0,0,22"
                  Checked="SettingChanged"
                  Unchecked="SettingChanged" />

        <Separator Background="#FFF0E7E1" Margin="0,0,0,16" />

        <TextBlock Text="背景音乐"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#FF604840"
                   Margin="0,0,0,10" />

        <CheckBox x:Name="MusicCheckBox"
                  Content="播放背景音乐"
                  FontSize="13"
                  Foreground="#FF49352F"
                  Checked="SettingChanged"
                  Unchecked="SettingChanged" />

        <TextBlock x:Name="MusicAvailabilityText"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#FF9A8177"
                   Margin="0,8,0,0" />

        <Separator Background="#FFF0E7E1" Margin="0,18,0,14" />

        <Button Content="恢复桌宠默认位置"
                HorizontalAlignment="Left"
                Padding="12,7"
                Background="#FFFFF1E8"
                BorderBrush="#FFE8CFC1"
                Foreground="#FF805C4F"
                Click="ResetPosition_Click" />

        <TextBlock x:Name="StatusText"
                   Text="设置会立即保存。"
                   FontSize="11"
                   Foreground="#FF8B7770"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Button Grid.Row="2"
            Content="完成"
            Width="104"
            Height="36"
            HorizontalAlignment="Right"
            Margin="0,18,0,0"
            Background="#FFB95F58"
            Foreground="White"
            BorderBrush="#FFB95F58"
            FontWeight="SemiBold"
            Click="Close_Click" />
  </Grid>
</Window>
