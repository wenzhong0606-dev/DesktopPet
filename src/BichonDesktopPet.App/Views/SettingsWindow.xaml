<Window x:Class="BichonDesktopPet.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="比熊桌宠设置"
        Width="440"
        Height="760"
        MinWidth="420"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#FFF8F5F1"
        Loaded="Window_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="桌宠设置"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="#FF49352F" />
      <TextBlock Text="调整比熊在桌面上的显示与陪伴效果"
                 Margin="0,6,0,0"
                 FontSize="12"
                 Foreground="#FF8B7770" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="White"
            BorderBrush="#FFE9DDD5"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0"
            ClipToBounds="True">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False"
                    Padding="18"
                    Focusable="False">
        <StackPanel>
          <TextBlock Text="桌面行为"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#FF604840"
                     Margin="0,0,0,14" />

          <CheckBox x:Name="AlwaysOnTopCheckBox"
                    Content="窗口始终置顶"
                    FontSize="13"
                    Foreground="#FF49352F"
                    Margin="0,0,0,16"
                    Checked="SettingChanged"
                    Unchecked="SettingChanged" />

          <CheckBox x:Name="SnowCheckBox"
                    Content="显示飘落的雪花"
                    FontSize="13"
                    Foreground="#FF49352F"
                    Margin="0,0,0,16"
                    Checked="SettingChanged"
                    Unchecked="SettingChanged" />

          <CheckBox x:Name="LightsCheckBox"
                    Content="开启装饰灯效果"
                    FontSize="13"
                    Foreground="#FF49352F"
                    Margin="0,0,0,22"
                    Checked="SettingChanged"
                    Unchecked="SettingChanged" />

          <Separator Background="#FFF0E7E1" Margin="0,0,0,16" />

          <TextBlock Text="智能关怀"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#FF604840"
                     Margin="0,0,0,10" />

          <CheckBox x:Name="ActivityAwarenessCheckBox"
                    Content="本地使用节奏感知与休息提醒"
                    FontSize="13"
                    Foreground="#FF49352F"
                    Margin="0,0,0,6"
                    Checked="SettingChanged"
                    Unchecked="SettingChanged" />

          <TextBlock Text="仅读取系统最近输入的空闲时长；不记录键盘内容、鼠标轨迹、应用名称或访问记录。连续活跃约一小时后温和提醒。"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="#FF8B7770"
                     Margin="0,0,0,18" />

          <Separator Background="#FFF0E7E1" Margin="0,0,0,16" />

          <TextBlock Text="生活地点与天气"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#FF604840"
                     Margin="0,0,0,10" />

          <CheckBox x:Name="AutomaticIpLocationCheckBox"
                    Content="允许通过公网 IP 自动估算所在城市"
                    FontSize="13"
                    Foreground="#FF49352F"
                    Margin="0,0,0,6"
                    Checked="SettingChanged"
                    Unchecked="SettingChanged" />

          <TextBlock Text="启用天气提醒后才会进行定位。开启后会将当前公网 IP 发送给 IPLogs，用于城市定位和 VPN/代理/中继检测。检测到匿名网络时不会采用出口城市；IPLogs 声明访问日志保留 30 天，地理信息来源 DB-IP（https://db-ip.com/，CC BY 4.0）。"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="#FF8B7770"
                     Margin="0,0,0,12" />

          <TextBlock Text="手动关注城市（优先于 IP 自动定位）"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#FF604840"
                     Margin="0,0,0,6" />

          <TextBox x:Name="PreferredLocationTextBox"
                   Height="34"
                   Padding="8,6"
                   FontSize="12"
                   BorderBrush="#FFE2D8D0"
                   Background="#FFFFFCFA" />

          <Button Content="保存关注城市"
                  HorizontalAlignment="Left"
                  Padding="12,7"
                  Margin="0,8,0,12"
                  Background="#FFFFF1E8"
                  BorderBrush="#FFE8CFC1"
                  Foreground="#FF805C4F"
                  Click="ApplyLocation_Click" />

          <CheckBox x:Name="WeatherRemindersCheckBox"
                    Content="启用天气关怀（降温、降雨、高温提醒）"
                    FontSize="13"
                    Foreground="#FF49352F"
                    Margin="0,0,0,6"
                    Checked="SettingChanged"
                    Unchecked="SettingChanged" />

          <TextBlock Text="天气提醒需要手动关注城市或启用 IP 自动定位。天气查询使用 Open-Meteo；城市坐标和网络请求会发送给天气服务。天气来源：https://open-meteo.com/；城市地理编码来源 GeoNames（https://www.geonames.org/）；均采用 CC BY 4.0。"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="#FF8B7770"
                     Margin="0,0,0,18" />

          <Separator Background="#FFF0E7E1" Margin="0,0,0,16" />

          <TextBlock Text="背景音乐"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#FF604840"
                     Margin="0,0,0,10" />

          <CheckBox x:Name="MusicCheckBox"
                    Content="播放背景音乐"
                    FontSize="13"
                    Foreground="#FF49352F"
                    Checked="SettingChanged"
                    Unchecked="SettingChanged" />

          <TextBlock x:Name="MusicAvailabilityText"
                     TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="#FF9A8177"
                     Margin="0,8,0,0" />

          <Separator Background="#FFF0E7E1" Margin="0,18,0,14" />

          <Button Content="恢复桌宠默认位置"
                  HorizontalAlignment="Left"
                  Padding="12,7"
                  Background="#FFFFF1E8"
                  BorderBrush="#FFE8CFC1"
                  Foreground="#FF805C4F"
                  Click="ResetPosition_Click" />

          <TextBlock x:Name="StatusText"
                     Text="设置会立即保存。"
                     FontSize="11"
                     Foreground="#FF8B7770"
                     Margin="0,12,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Button Grid.Row="2"
            Content="完成"
            Width="104"
            Height="36"
            HorizontalAlignment="Right"
            Margin="0,18,0,0"
            Background="#FFB95F58"
            Foreground="White"
            BorderBrush="#FFB95F58"
            FontWeight="SemiBold"
            Click="Close_Click" />
  </Grid>
</Window>
