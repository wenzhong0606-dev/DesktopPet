<Window x:Class="BichonDesktopPet.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和伙伴聊天"
        Width="480"
        Height="640"
        MinWidth="380"
        MinHeight="480"
        Background="#FFF7F5F2"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock x:Name="CompanionNameText"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="#FF493B36" />
      <TextBlock x:Name="ConnectionStatusText"
                 Margin="0,5,0,0"
                 FontSize="12"
                 Foreground="#FF8A7168"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="#FFFFFFFF"
            BorderBrush="#FFE8DED8"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12">
      <ScrollViewer x:Name="ConversationScroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="MessagePanel" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="MessageInput"
               Grid.Column="0"
               MinHeight="42"
               MaxHeight="110"
               Padding="10"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto"
               VerticalContentAlignment="Center"
               FontSize="14"
               KeyDown="MessageInput_KeyDown" />
      <Button x:Name="SendButton"
              Grid.Column="1"
              Width="76"
              Margin="8,0,0,0"
              Content="发送"
              IsDefault="True"
              Click="SendButton_Click" />
    </Grid>
  </Grid>
</Window>
