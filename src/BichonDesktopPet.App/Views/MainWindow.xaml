<Window x:Class="BichonDesktopPet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="比熊桌宠"
        Width="280"
        Height="360"
        MinWidth="280"
        MinHeight="360"
        MaxWidth="280"
        MaxHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="设置..." Click="Settings_Click" />
        <MenuItem Header="角色管理..." Click="Avatars_Click" />
        <Separator />
        <MenuItem Header="显示 / 隐藏雪花" Click="ToggleSnow_Click" />
        <MenuItem Header="显示 / 隐藏装饰灯" Click="ToggleLights_Click" />
        <MenuItem Header="拆开礼物" Click="GiftButton_Click" />
        <MenuItem Header="背景音乐（默认关闭）" Click="ToggleMusic_Click" />
        <MenuItem Header="隐藏桌宠" Click="Hide_Click" />
        <Separator />
        <MenuItem Header="退出桌宠" Click="Exit_Click" />
      </ContextMenu>
    </Grid.ContextMenu>

    <!-- Decorative lights sit behind the character and remain visible through transparent pixels. -->
    <Canvas x:Name="DecorationCanvas" Width="280" Height="360" IsHitTestVisible="False">
      <Ellipse x:Name="LightOne" Canvas.Left="15" Canvas.Top="48" Width="11" Height="11"
               Fill="#FFFFD36B" Opacity="0.9" />
      <Ellipse x:Name="LightTwo" Canvas.Left="254" Canvas.Top="53" Width="10" Height="10"
               Fill="#FFFF7B83" Opacity="0.65" />
      <Ellipse x:Name="LightThree" Canvas.Left="13" Canvas.Top="258" Width="9" Height="9"
               Fill="#FF83D9B1" Opacity="0.8" />
      <Ellipse x:Name="LightFour" Canvas.Left="257" Canvas.Top="252" Width="9" Height="9"
               Fill="#FF9BC8FF" Opacity="0.7" />
    </Canvas>

    <Canvas x:Name="PetCanvas"
            Width="280"
            Height="360"
            Background="Transparent"
            MouseLeftButtonUp="PetCanvas_MouseLeftButtonUp"
            RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform>
        <RotateTransform x:Name="PetRotate" Angle="0" />
      </Canvas.RenderTransform>

      <!-- Keep the lightweight vector fallback only for missing or invalid runtime PNG assets. -->
      <Canvas x:Name="FallbackPetCanvas" Width="280" Height="360" IsHitTestVisible="False">
        <Ellipse Canvas.Left="54" Canvas.Top="319" Width="172" Height="22" Fill="#260F0B08" />
        <Ellipse Canvas.Left="68" Canvas.Top="177" Width="144" Height="150"
                 Fill="#FFF9F1" Stroke="#E8DCD1" StrokeThickness="1.2" />
        <Ellipse Canvas.Left="77" Canvas.Top="270" Width="57" Height="65"
                 Fill="#FFFCF7" Stroke="#E8DCD1" StrokeThickness="1" />
        <Ellipse Canvas.Left="146" Canvas.Top="270" Width="57" Height="65"
                 Fill="#FFFCF7" Stroke="#E8DCD1" StrokeThickness="1" />
        <Path Data="M 76,207 C 93,191 187,191 204,207 L 218,292 C 194,310 86,310 62,292 Z"
              Fill="#FFF4F0" Stroke="#C85A58" StrokeThickness="2.5" />
        <Path Data="M 77,224 C 104,239 176,239 203,224"
              Stroke="#D85C61" StrokeThickness="5" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />
        <Path Data="M 72,286 C 105,300 175,300 208,286"
              Stroke="#E5B6B0" StrokeThickness="3" StrokeDashArray="1,3" />
        <Ellipse Canvas.Left="27" Canvas.Top="91" Width="79" Height="104"
                 Fill="#FFF9F3" Stroke="#E6D8CE" StrokeThickness="1.2" />
        <Ellipse Canvas.Left="174" Canvas.Top="91" Width="79" Height="104"
                 Fill="#FFF9F3" Stroke="#E6D8CE" StrokeThickness="1.2" />
        <Ellipse Canvas.Left="44" Canvas.Top="36" Width="192" Height="190"
                 Fill="#FFFEFA" Stroke="#E6D8CE" StrokeThickness="1.2" />
        <Ellipse Canvas.Left="54" Canvas.Top="57" Width="50" Height="54" Fill="#FFFFFFFF" />
        <Ellipse Canvas.Left="177" Canvas.Top="57" Width="50" Height="54" Fill="#FFFFFFFF" />
        <Ellipse Canvas.Left="48" Canvas.Top="112" Width="45" Height="50" Fill="#FFFFFFFF" />
        <Ellipse Canvas.Left="187" Canvas.Top="112" Width="45" Height="50" Fill="#FFFFFFFF" />
        <Ellipse Canvas.Left="79" Canvas.Top="139" Width="122" Height="78" Fill="#FFFFFCF7" />
        <Ellipse Canvas.Left="72" Canvas.Top="165" Width="44" Height="34" Fill="#FFFFFCF7" />
        <Ellipse Canvas.Left="164" Canvas.Top="165" Width="44" Height="34" Fill="#FFFFFCF7" />
        <Ellipse Canvas.Left="88" Canvas.Top="111" Width="31" Height="39" Fill="#FF321D1A" />
        <Ellipse Canvas.Left="161" Canvas.Top="111" Width="31" Height="39" Fill="#FF321D1A" />
        <Ellipse Canvas.Left="96" Canvas.Top="118" Width="9" Height="10" Fill="White" />
        <Ellipse Canvas.Left="169" Canvas.Top="118" Width="9" Height="10" Fill="White" />
        <Ellipse Canvas.Left="64" Canvas.Top="157" Width="32" Height="15" Fill="#55F29B91" />
        <Ellipse Canvas.Left="184" Canvas.Top="157" Width="32" Height="15" Fill="#55F29B91" />
        <Ellipse Canvas.Left="119" Canvas.Top="158" Width="43" Height="32" Fill="#FF49302A" />
        <Ellipse Canvas.Left="129" Canvas.Top="162" Width="12" Height="5" Fill="#88FFFFFF" />
        <Path Data="M 132,190 Q 140,197 148,190"
              Stroke="#FF51352F" StrokeThickness="2.2" Fill="Transparent"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path Data="M 91,208 Q 140,229 189,208"
              Stroke="#D84D50" StrokeThickness="7" Fill="Transparent"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path Data="M 124,218 C 105,203 101,228 132,234 C 118,250 145,248 143,230 C 171,225 163,203 143,218 Z"
              Fill="#C9343D" Stroke="#A92731" StrokeThickness="1" />
        <Ellipse Canvas.Left="133" Canvas.Top="229" Width="17" Height="19"
                 Fill="#E7B94D" Stroke="#A87828" StrokeThickness="1" />
        <Path Data="M 138,246 L 138,250" Stroke="#79501D" StrokeThickness="1.5" />
      </Canvas>

      <Image x:Name="PetImage"
             Canvas.Left="10"
             Canvas.Top="0"
             Width="260"
             Height="333"
             Stretch="Uniform"
             RenderOptions.BitmapScalingMode="HighQuality"
             IsHitTestVisible="False"
             Visibility="Collapsed" />

      <Border Canvas.Left="67"
              Canvas.Top="338"
              Width="146"
              Height="19"
              CornerRadius="9"
              Background="#DFFFFAF6"
              BorderBrush="#55D8C1B7"
              BorderThickness="1"
              IsHitTestVisible="False">
        <TextBlock x:Name="StatusText"
                   Text="你好呀"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#FF765C55"
                   FontSize="10"
                   FontWeight="SemiBold" />
      </Border>
    </Canvas>

    <Canvas x:Name="SnowCanvas" Width="280" Height="360" IsHitTestVisible="False" />
  </Grid>
</Window>
